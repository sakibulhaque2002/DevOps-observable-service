PORT=8080
LOG_LEVEL=INFO
ENVIRONMENT=local
APP_VERSION=1.0.0
# Set a unique password before starting the monitoring profile.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
ENABLE_DEMO_ENDPOINTS=false
DEMO_TOKEN=
# Default: collect every Docker container, including containers outside Compose.
# On a shared workstation, set devops-observable to limit collection to this project.
DOCKER_LOG_PROJECT_REGEX=.*
